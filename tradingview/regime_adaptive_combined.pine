// ═══════════════════════════════════════════════════════════════════════════
// AI Trading Engine — Combined Regime-Based Strategy (Backtest)
// Converted from: strategies/regime.py + trend.py + mean_reversion.py + breakout.py
//
// Logic:
//   1. Classify regime: TREND | CHOP | EXPANSION | UNCERTAIN
//   2. Route to matching strategy:
//      TREND     → EMA Trend Momentum
//      CHOP      → VWAP Mean Reversion
//      EXPANSION → Volatility Breakout
//      UNCERTAIN → No trade
//
// All parameters match config/settings.py defaults exactly.
// ═══════════════════════════════════════════════════════════════════════════

//@version=5
strategy("AI Engine — Regime Adaptive", overlay=true, default_qty_type=strategy.percent_of_equity,
     default_qty_value=10, initial_capital=5000, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=1, pyramiding=0)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

grpRegime = "── Regime Classifier ──"
adxPeriod      = input.int(14,    "ADX Period",              group=grpRegime, minval=5)
adxTrendThr    = input.float(25,  "ADX Trend Threshold",     group=grpRegime, minval=10)
adxChopThr     = input.float(20,  "ADX Chop Threshold",      group=grpRegime, minval=5)
atrExpRatio    = input.float(1.3, "ATR Expansion Ratio",     group=grpRegime, minval=1.0, step=0.1)
volSpikeMult   = input.float(1.5, "Volume Spike Multiplier", group=grpRegime, minval=1.0, step=0.1)

grpTrend = "── EMA Trend Momentum ──"
emaFastLen     = input.int(20,    "EMA Fast",                group=grpTrend, minval=5)
emaSlowLen     = input.int(50,    "EMA Slow",                group=grpTrend, minval=10)
emaFilterLen   = input.int(200,   "EMA Filter (200)",        group=grpTrend, minval=50)
volTrendMult   = input.float(1.2, "Vol Trend Multiplier",    group=grpTrend, minval=1.0, step=0.1)
trendStopMult  = input.float(1.2, "Trend Stop (ATR ×)",      group=grpTrend, minval=0.5, step=0.1)
trendTPMult    = input.float(1.5, "Trend TP (× R)",          group=grpTrend, minval=1.0, step=0.25)
slopeLen       = input.int(5,     "Slope Lookback",          group=grpTrend, minval=2)

grpMR = "── VWAP Mean Reversion ──"
rsiPeriod      = input.int(14,    "RSI Period",              group=grpMR, minval=5)
rsiOS          = input.float(30,  "RSI Oversold",            group=grpMR, minval=10, maxval=50)
rsiOB          = input.float(70,  "RSI Overbought",          group=grpMR, minval=50, maxval=95)
vwapDevPct     = input.float(0.8, "VWAP Dev % (abs)",        group=grpMR, minval=0.1, step=0.1)

grpBO = "── Volatility Breakout ──"
boLookback     = input.int(20,    "Breakout Lookback",       group=grpBO, minval=5)
boTPMult       = input.float(2.0, "Breakout TP (× R)",       group=grpBO, minval=1.0, step=0.25)

atrPeriod      = input.int(14,    "ATR Period (shared)",     minval=5)

// ═══════════════════════════════════════════════════════════════════════════
// SHARED INDICATORS
// ═══════════════════════════════════════════════════════════════════════════

emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
emaFilter = ta.ema(close, emaFilterLen)
atr14     = ta.atr(atrPeriod)
atr50     = ta.atr(50)
volMA20   = ta.sma(volume, 20)
[diplus, diminus, adxVal] = ta.dmi(adxPeriod, adxPeriod)

atrRatio   = atr50 != 0 ? atr14 / atr50 : 0.0
emaSpread  = emaSlow != 0 ? math.abs(emaFast - emaSlow) / emaSlow : 0.0

// ═══════════════════════════════════════════════════════════════════════════
// REGIME CLASSIFIER  (matches regime.py exactly)
// ═══════════════════════════════════════════════════════════════════════════

REGIME_TREND     = 1
REGIME_CHOP      = 2
REGIME_EXPANSION = 3
REGIME_UNCERTAIN = 0

regime = adxVal > adxTrendThr and emaSpread > 0.004 ? REGIME_TREND :
     adxVal < adxChopThr  and atrRatio < 1.0     ? REGIME_CHOP  :
     atrRatio > atrExpRatio and volume > volSpikeMult * volMA20 ? REGIME_EXPANSION :
     REGIME_UNCERTAIN

// ═══════════════════════════════════════════════════════════════════════════
// STRATEGY 1: EMA TREND MOMENTUM   (active in TREND regime)
// ═══════════════════════════════════════════════════════════════════════════

emaSlope = emaFast[slopeLen] != 0 ? (emaFast - emaFast[slopeLen]) / emaFast[slopeLen] : 0.0

trendLong = regime == REGIME_TREND and
     emaFast > emaSlow and
     close > emaFilter and
     adxVal > adxTrendThr and
     emaSlope > 0 and
     volume > volTrendMult * volMA20

trendShort = regime == REGIME_TREND and
     emaFast < emaSlow and
     close < emaFilter and
     adxVal > adxTrendThr and
     emaSlope < 0 and
     volume > volTrendMult * volMA20

// ═══════════════════════════════════════════════════════════════════════════
// STRATEGY 2: VWAP MEAN REVERSION   (active in CHOP regime)
// ═══════════════════════════════════════════════════════════════════════════

vwapVal    = ta.vwap(hlc3)
rsiVal     = ta.rsi(close, rsiPeriod)
vwapDev    = vwapVal != 0 ? (close - vwapVal) / vwapVal * 100.0 : 0.0
volMA3Now  = ta.sma(volume, 3)
volMA3Prev = ta.sma(volume, 3)[3]
volDecline = volMA3Now < volMA3Prev

mrLong = regime == REGIME_CHOP and
     vwapDev < -vwapDevPct and
     rsiVal < rsiOS and
     volDecline

mrShort = regime == REGIME_CHOP and
     vwapDev > vwapDevPct and
     rsiVal > rsiOB and
     volDecline

// ═══════════════════════════════════════════════════════════════════════════
// STRATEGY 3: VOLATILITY BREAKOUT   (active in EXPANSION regime)
// ═══════════════════════════════════════════════════════════════════════════

rangeUpper = ta.highest(high[1], boLookback)
rangeLower = ta.lowest(low[1],   boLookback)
volMaBO    = ta.sma(volume, boLookback)

boLong = regime == REGIME_EXPANSION and
     close > rangeUpper and
     atrRatio > atrExpRatio and
     volume > volSpikeMult * volMaBO

boShort = regime == REGIME_EXPANSION and
     close < rangeLower and
     atrRatio > atrExpRatio and
     volume > volSpikeMult * volMaBO

// ═══════════════════════════════════════════════════════════════════════════
// ENTRIES & EXITS
// ═══════════════════════════════════════════════════════════════════════════

noPosition = strategy.position_size == 0

// ── Trend entries ───────────────────────────────────────────────────────
if trendLong and noPosition
    sl   = close - trendStopMult * atr14
    risk = close - sl
    tp   = close + trendTPMult * risk
    strategy.entry("T-Long", strategy.long)
    strategy.exit("T-L Exit", "T-Long", stop=sl, limit=tp)

if trendShort and noPosition
    sl   = close + trendStopMult * atr14
    risk = sl - close
    tp   = close - trendTPMult * risk
    strategy.entry("T-Short", strategy.short)
    strategy.exit("T-S Exit", "T-Short", stop=sl, limit=tp)

// ── Mean Reversion entries ──────────────────────────────────────────────
if mrLong and noPosition
    sl = close - atr14
    tp = vwapVal
    strategy.entry("MR-Long", strategy.long)
    strategy.exit("MR-L Exit", "MR-Long", stop=sl, limit=tp)

if mrShort and noPosition
    sl = close + atr14
    tp = vwapVal
    strategy.entry("MR-Short", strategy.short)
    strategy.exit("MR-S Exit", "MR-Short", stop=sl, limit=tp)

// ── Breakout entries ────────────────────────────────────────────────────
if boLong and noPosition
    sl   = math.min(low, close - atr14)
    risk = close - sl
    tp   = close + boTPMult * risk
    strategy.entry("BO-Long", strategy.long)
    strategy.exit("BO-L Exit", "BO-Long", stop=sl, limit=tp)

if boShort and noPosition
    sl   = math.max(high, close + atr14)
    risk = sl - close
    tp   = close - boTPMult * risk
    strategy.entry("BO-Short", strategy.short)
    strategy.exit("BO-S Exit", "BO-Short", stop=sl, limit=tp)

// ═══════════════════════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════════════════════

// EMA ribbons
plot(emaFast,   "EMA 20",  color=color.yellow,               linewidth=1)
plot(emaSlow,   "EMA 50",  color=color.orange,               linewidth=1)
plot(emaFilter, "EMA 200", color=color.new(color.gray, 40),  linewidth=1)
plot(vwapVal,   "VWAP",    color=color.new(color.purple, 30),linewidth=2, style=plot.style_stepline)

// Breakout range
plot(rangeUpper, "Range Hi", color=color.new(color.teal, 60),   linewidth=1, style=plot.style_circles)
plot(rangeLower, "Range Lo", color=color.new(color.orange, 60), linewidth=1, style=plot.style_circles)

// ── Regime background ───────────────────────────────────────────────────
regimeColor = regime == REGIME_TREND     ? color.new(color.green,  90) :
              regime == REGIME_CHOP      ? color.new(color.yellow, 90) :
              regime == REGIME_EXPANSION ? color.new(color.blue,   90) :
              color.new(color.gray, 95)
bgcolor(regimeColor, title="Regime BG")

// ── Regime label ────────────────────────────────────────────────────────
regimeStr = switch regime
    REGIME_TREND     => "TREND"
    REGIME_CHOP      => "CHOP"
    REGIME_EXPANSION => "EXPANSION"
    => "UNCERTAIN"

var label regLabel = na
if barstate.islast
    if not na(regLabel)
        label.delete(regLabel)
    regLabel := label.new(bar_index, high, regimeStr,
         style=label.style_label_down, size=size.normal,
         color=regime == REGIME_TREND ? color.green :
               regime == REGIME_CHOP  ? color.yellow :
               regime == REGIME_EXPANSION ? color.blue : color.gray,
         textcolor=color.white)

// ── Signal markers ──────────────────────────────────────────────────────
anyLong  = (trendLong or mrLong or boLong)   and noPosition
anyShort = (trendShort or mrShort or boShort) and noPosition
plotshape(anyLong,  "Buy",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(anyShort, "Sell", shape.triangledown, location.abovebar, color.red,   size=size.small)

// ── Info table ──────────────────────────────────────────────────────────
var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70),
     frame_color=color.gray, frame_width=1, border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(infoTable, 0, 0, "Regime",         text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, regimeStr,         text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 1, "ADX",             text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(adxVal, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 2, "ATR Ratio",       text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(atrRatio, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 3, "RSI",             text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(rsiVal, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 4, "VWAP Dev %",      text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(vwapDev, "#.##") + "%", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 5, "EMA Spread %",    text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(emaSpread * 100, "#.##") + "%", text_color=color.white, text_size=size.small)
