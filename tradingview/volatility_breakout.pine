// ═══════════════════════════════════════════════════════════════════════════
// Volatility Breakout Strategy — TradingView Backtest
// Converted from: strategies/breakout.py
//
// Range: Upper = max(High, 20 bars), Lower = min(Low, 20 bars)
// Long entry (all true):
//   1. Price > Upper                      — breakout above range
//   2. ATR(14) / ATR(50) > 1.3            — volatility expanding
//   3. Volume > 1.5 × SMA(Volume, 20)    — volume surge
//
// Short: mirror (Price < Lower).
// Stop  : min(candle_low, price − ATR(14))  for longs
// Target: 2.0 × R
// ═══════════════════════════════════════════════════════════════════════════

//@version=5
strategy("Volatility Breakout", overlay=true, default_qty_type=strategy.percent_of_equity,
     default_qty_value=10, initial_capital=5000, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=1, pyramiding=0)

// ── Inputs ──────────────────────────────────────────────────────────────────
lookback       = input.int(20,   "Breakout Lookback",       minval=5)
atrFastLen     = input.int(14,   "ATR Fast",                minval=5)
atrSlowLen     = input.int(50,   "ATR Slow",                minval=20)
atrExpRatio    = input.float(1.3,"ATR Expansion Ratio",     minval=1.0, step=0.1)
volSpikeMult   = input.float(1.5,"Volume Spike Multiplier", minval=1.0, step=0.1)
tpMultiple     = input.float(2.0,"Take-Profit (x R)",       minval=1.0, step=0.25)

// ── Indicators ──────────────────────────────────────────────────────────────
// 20-bar range (excluding the current bar → offset by 1)
upper = ta.highest(high[1], lookback)
lower = ta.lowest(low[1], lookback)

atrFast  = ta.atr(atrFastLen)
atrSlow  = ta.atr(atrSlowLen)
atrRatio = atrSlow != 0 ? atrFast / atrSlow : 0

volMA = ta.sma(volume, lookback)

// ── Conditions ──────────────────────────────────────────────────────────────
volatilityOK = atrRatio > atrExpRatio
volumeOK     = volume > volSpikeMult * volMA

longCond  = close > upper and volatilityOK and volumeOK
shortCond = close < lower and volatilityOK and volumeOK

// ── Entries ─────────────────────────────────────────────────────────────────
if longCond and strategy.position_size == 0
    stopLoss   = math.min(low, close - atrFast)
    risk       = close - stopLoss
    takeProfit = close + tpMultiple * risk
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP/SL", "Long", stop=stopLoss, limit=takeProfit)

if shortCond and strategy.position_size == 0
    stopLoss   = math.max(high, close + atrFast)
    risk       = stopLoss - close
    takeProfit = close - tpMultiple * risk
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP/SL", "Short", stop=stopLoss, limit=takeProfit)

// ── Plots ───────────────────────────────────────────────────────────────────
pU = plot(upper, "Range Upper", color=color.new(color.teal, 40), linewidth=1)
pL = plot(lower, "Range Lower", color=color.new(color.orange, 40), linewidth=1)
fill(pU, pL, color=color.new(color.blue, 92), title="Range Band")

// Volume spike highlight
bgcolor(volumeOK ? color.new(color.yellow, 92) : na, title="Volume Spike")

// Signal markers
plotshape(longCond  and strategy.position_size == 0, "Long",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(shortCond and strategy.position_size == 0, "Short", shape.triangledown, location.abovebar, color.red,   size=size.small)
